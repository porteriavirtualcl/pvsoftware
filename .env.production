# ─── Variables de entorno para producción (Hostinger) ────────────────────────
#
# INSTRUCCIONES:
#   Completá los valores directamente en el panel de Hostinger:
#   hPanel → Hosting → Node.js → Environment Variables
#   O bien editá este archivo directamente en el servidor via SSH/File Manager.
#
#   IMPORTANTE: Este archivo es leído por server.cjs en producción (dotenv).
#   NUNCA pongas aquí valores reales y hagas commit — usá el panel de Hostinger.

# Puerto — Hostinger lo asigna automáticamente, no cambiar
PORT=

# Dahua DSS Pro — credenciales SERVER-SIDE (nunca en el bundle del frontend)
DAHUA_HOST=https://vdp.porteriavirtual.cl
DAHUA_USER=api
DAHUA_PASS=

# Firebase (si se usa service account en lugar del archivo .json)
# FIREBASE_PROJECT_ID=porteriavitual-7d04e
