rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions (FAIL-SAFE)
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Direct email-based check (Bypasses doc lookup errors)
    function isMasterAdminEmail() {
      return request.auth.token.email in [
        'contacto@porteriavirtual.cl',
        'cristianmedinaflores@gmail.com',
        'contacto@maipobodegas.cl'
      ];
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (getProfile().role == 'super_admin' || isMasterAdminEmail());
    }

    function isCondoAdmin(condoId) {
      return isAuthenticated() && (
        (getProfile().role == 'condo_admin' && getProfile().condoId == condoId) ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // Collections
    // ===============================================================

    // Collection: users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Collection: condos
    match /condos/{condoId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
      
      // Sub-collections inside condos
      match /{allSubcollections=**} {
        allow read: if isAuthenticated() && (isSuperAdmin() || getProfile().condoId == condoId);
        allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role == 'condo_admin');
      }
    }

    // Collection: devices (GLOBAL)
    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isSuperAdmin() || isMasterAdminEmail());
      allow delete: if isSuperAdmin();
    }

    // Collection: hardware_commands (DIRECT OPEN/CLOSE CMDS)
    match /hardware_commands/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // Collection: sync_queue (GLOBAL HARDWARE BRIDGE)
    match /sync_queue/{id} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Collection Groups (For global queries as SuperAdmin)
    match /{path=**}/equipment/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/reservations/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/expenses/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/residents/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/visitors/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/incidents/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/facilities/{id} { allow read: if isAuthenticated(); }
  }
}
