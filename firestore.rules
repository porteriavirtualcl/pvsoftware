rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "contacto@porteriavirtual.cl" || 
        request.auth.token.email == "cristianmedinaflores@gmail.com" ||
        getProfile().role == 'super_admin'
      );
    }

    function isMasterAdminEmail() {
      return request.auth.token.email in [
        'contacto@porteriavirtual.cl',
        'cristianmedinaflores@gmail.com',
        'contacto@maipobodegas.cl'
      ];
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Returns true if the current user has access to the given condoId:
    // covers condoScope='all', single condoId match, and condoIds[] array membership.
    function hasCondoAccess(condoId) {
      let p = getProfile();
      return isSuperAdmin() ||
        p.get('condoScope', '') == 'all' ||
        p.get('condoId', '') == condoId ||
        (p.get('condoIds', null) != null && condoId in p.get('condoIds', []));
    }

    // Direct access for collectionGroup queries
    match /{path=**}/facilities/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/equipment/{id}  { allow read: if isAuthenticated(); }
    // Incidents: read for all authenticated; write allowed for any staff role
    match /{path=**}/incidents/{id}  {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','operator','technician'];
      allow update: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','operator','technician'];
    }
    match /{path=**}/operators/{id}     { allow read: if isAuthenticated(); }
    match /{path=**}/access_events/{id} { allow read: if isAuthenticated(); }
    // Eventos de acceso persistidos (Fase 1): lectura SOLO del condominio propio
    // (el super_admin pasa por hasCondoAccess). Escritura: solo el servidor (Admin SDK).
    match /{path=**}/accessEvents/{id} {
      allow read:  if isAuthenticated() && hasCondoAccess(resource.data.condoId);
      allow write: if false;
    }
    match /{path=**}/accessDaily/{id} {
      allow read:  if isAuthenticated() && hasCondoAccess(resource.data.condoId);
      allow write: if false;
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Owner or super_admin can always write; condo_admin can manage their staff
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || getProfile().role == 'condo_admin');
      // condo_admin can create staff profiles (technicians, operators) for their condo
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || getProfile().role == 'condo_admin');
      // Allow a user to delete their own pre-registration temp doc (matched by email)
      // This is required for the auth migration flow that moves temp docs to users/{uid}
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || resource.data.email == request.auth.token.email);
    }

    match /condos/{condoId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();

      // Residents and operators of this condo can read/write visitors
      match /visitors/{visitorId} {
        allow read, write: if isAuthenticated() && hasCondoAccess(condoId);
      }

      // Residents can create/delete their own reservations; staff can manage all
      match /reservations/{reservationId} {
        allow read: if isAuthenticated() && hasCondoAccess(condoId);
        allow create: if isAuthenticated() && hasCondoAccess(condoId);
        allow update: if isAuthenticated() && (hasCondoAccess(condoId) && getProfile().role in ['condo_admin', 'operator']);
        allow delete: if isAuthenticated() && (
          isSuperAdmin() ||
          getProfile().role in ['condo_admin', 'operator'] ||
          (hasCondoAccess(condoId) && resource.data.userId == request.auth.uid)
        );
      }

      // Parcels: operators/admins create & mark as picked up; residents read.
      // Residents may ALSO mark their OWN parcel as picked up (pending -> picked_up).
      match /parcels/{parcelId} {
        allow read: if isAuthenticated() && hasCondoAccess(condoId);
        allow create: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin', 'operator']);
        allow update: if isAuthenticated() && (
          isSuperAdmin() || getProfile().role in ['condo_admin', 'operator']
          || (
            resource.data.residentUserId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'picked_up'
          )
        );
        allow delete: if isAuthenticated() && isSuperAdmin();
      }

      // Subcolecciones operativas accesibles por el cliente. Se ENUMERAN explícitamente
      // (en vez de un catch-all `**`) para que las subcolecciones solo-servidor —en
      // especial `consents` (RUT + consentimiento biométrico)— queden denegadas al cliente;
      // el Admin SDK del servidor las escribe/lee sin pasar por estas reglas.
      match /equipment/{document=**}  { allow read: if isAuthenticated() && hasCondoAccess(condoId); allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin','operator','technician']); }
      match /facilities/{document=**} { allow read: if isAuthenticated() && hasCondoAccess(condoId); allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin','operator']); }
      match /incidents/{document=**}  { allow read: if isAuthenticated() && hasCondoAccess(condoId); allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin','operator','technician']); }
      match /expenses/{document=**}   { allow read: if isAuthenticated() && hasCondoAccess(condoId); allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin','operator']); }
      match /alicuotas/{document=**}  { allow read: if isAuthenticated() && hasCondoAccess(condoId); allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin','operator']); }
      match /fondo/{document=**}      { allow read: if isAuthenticated() && hasCondoAccess(condoId); allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin','operator']); }
      match /gasto/{document=**}      { allow read: if isAuthenticated() && hasCondoAccess(condoId); allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin','operator']); }
      match /multas/{document=**}     { allow read: if isAuthenticated() && hasCondoAccess(condoId); allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin','operator']); }

      // Consentimientos (Ley 21.719) — dato sensible: SOLO servidor (Admin SDK).
      match /consents/{document=**}   { allow read, write: if false; }
    }

    // App-wide config (role access, feature flags, etc.)
    // All authenticated users read; only super_admin writes.
    match /config/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Kiosks / dispositivos de lockers-buzones. Configuración lógica administrada
    // por super_admin desde la app. El kiosco (Admin SDK / service account) lee y
    // escribe SIN pasar por estas reglas.
    match /kiosks/{kioskId} {
      allow read:  if isAuthenticated();     // staff puede ver los equipos
      allow write: if isSuperAdmin();        // solo super_admin administra

      // Comandos de apertura remota. Los crea un operador/admin; el kiosco
      // (Admin SDK) los lee y actualiza su estado SIN pasar por estas reglas.
      match /commands/{cmdId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','operator'];
        allow update, delete: if isSuperAdmin();
      }
    }

    // Datos SOLO-servidor (Admin SDK): solicitudes de derechos y tokens de ratificación
    // de consentimiento. El cliente nunca los toca directamente (todo vía API).
    match /rightsRequests/{id} { allow read, write: if false; }
    match /ratifyTokens/{id}   { allow read, write: if false; }

    match /notifications/{docId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // WhatsApp numbers — admins/operators read; only super_admin/condo_admin write
    match /waNumbers/{numberId} {
      allow read: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','administrador','operator'];
      allow write: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin'];
    }

    // WhatsApp conversations — admins/operators read & update (mark read)
    match /waConversations/{convId} {
      allow read: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','administrador','operator'];
      allow create, update: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','administrador','operator'];
      allow delete: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin'];

      match /messages/{msgId} {
        allow read: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','administrador','operator'];
        allow create: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','administrador','operator'];
        allow update, delete: if false;
      }
    }

    // Communications — staff can read & create; only super_admin can delete
    match /communications/{commId} {
      allow read: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','administrador','operator'];
      allow create: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','administrador','operator'];
      allow update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // Collection groups con datos personales: lectura SOLO del condominio propio
    // (el super_admin / scope 'all' pasan por hasCondoAccess). Evita fuga cross-tenant.
    match /{path=**}/reservations/{id} { allow read: if isAuthenticated() && hasCondoAccess(resource.data.condoId); }
    match /{path=**}/expenses/{id}     { allow read: if isAuthenticated() && hasCondoAccess(resource.data.condoId); }
    match /{path=**}/residents/{id}    { allow read: if isAuthenticated() && hasCondoAccess(resource.data.condoId); }
    match /{path=**}/visitors/{id}     { allow read: if isAuthenticated() && hasCondoAccess(resource.data.condoId); }
  }
}
