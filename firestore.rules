rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function hasRole(role) {
      let profile = getProfile();
      return profile != null && profile.role == role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "contacto@porteriavirtual.cl" || 
        request.auth.token.email == "cristianmedinaflores@gmail.com" || 
        hasRole('super_admin')
      );
    }

    function isCondoAdmin(condoId) {
      let profile = getProfile();
      return profile != null && profile.role == 'condo_admin' && (profile.condoId == condoId || (profile.condoIds != null && profile.condoIds.hasAny([condoId])));
    }

    function isOperator(condoId) {
      let profile = getProfile();
      return profile != null && (profile.role == 'operator' || profile.role == 'usuario') && profile.condoId == condoId;
    }

    function isTechnician(condoId) {
      let profile = getProfile();
      return profile != null && profile.role == 'technician' && profile.condoId == condoId;
    }

    function isResident(condoId) {
      let profile = getProfile();
      return profile != null && profile.role == 'resident' && profile.condoId == condoId;
    }

    // Validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['super_admin', 'condo_admin', 'operator', 'technician', 'resident', 'usuario'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Root-level access to certain collections for collectionGroup queries
    match /{path=**}/facilities/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/equipment/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/incidents/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/operators/{id} { allow read: if isAuthenticated(); }

    match /users/{userId} {
      // Permission to read: self, super admin, or by email lookup, or condo admin for its users
      allow read: if isOwner(userId) || isSuperAdmin() || (isAuthenticated() && resource != null && (request.auth.token.email == resource.data.email || isCondoAdmin(resource.data.condoId)));
      allow list: if isSuperAdmin() || (isAuthenticated() && request.auth.token.email != null);
      
      allow create: if isAuthenticated() && (isOwner(userId) || isSuperAdmin() || (request.resource != null && isCondoAdmin(request.resource.data.condoId))) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(userId) || isSuperAdmin() || (resource != null && isCondoAdmin(resource.data.condoId))) && isValidUser(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /condos/{condoId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();

      match /buildings/{buildingId} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin() || isCondoAdmin(condoId);
      }

      match /equipment/{equipmentId} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin() || isCondoAdmin(condoId) || isTechnician(condoId) || hasRole('technician');
      }

      match /incidents/{incidentId} {
        allow read: if isAuthenticated();
        allow create: if isOperator(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOperator(condoId) || isCondoAdmin(condoId) || isTechnician(condoId) || isSuperAdmin();
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /facilities/{facilityId} {
        allow read: if isAuthenticated();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /reservations/{reservationId} {
        allow read: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow create: if isResident(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /visitors/{visitorId} {
        allow read: if isOwner(resource.data.userId) || isOperator(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow create: if isResident(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /plannedVisits/{visitId} {
        allow read: if isAuthenticated();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /operators/{operatorId} {
        allow read: if isAuthenticated();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }
    }

    // New Notifications Collection
    match /notifications/{notificationId} {
      allow read: if (resource != null && isOwner(resource.data.userId)) || isSuperAdmin();
      allow create: if isAuthenticated();
      allow update: if (resource != null && isOwner(resource.data.userId)) || isSuperAdmin();
      allow delete: if (resource != null && isOwner(resource.data.userId)) || isSuperAdmin();
    }
  }
}
