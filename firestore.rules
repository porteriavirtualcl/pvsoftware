rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: uid
    // Fields:
    //   - uid: string (required)
    //   - email: string (required, email format)
    //   - name: string
    //   - role: string (enum: super_admin, condo_admin, operator, technician, resident)
    //   - condoId: string (optional)
    //
    // Collection: condos
    // Document ID: condoId
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - address: string
    //
    // [Other collections follow the blueprint]
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getProfile().role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin') || (request.auth.token.email == "cristianmedinaflores@gmail.com" && request.auth.token.email_verified == true);
    }

    function isCondoAdmin(condoId) {
      let profile = getProfile();
      return profile.role == 'condo_admin' && profile.condoId == condoId;
    }

    function isOperator(condoId) {
      let profile = getProfile();
      return profile.role == 'operator' && profile.condoId == condoId;
    }

    function isTechnician(condoId) {
      let profile = getProfile();
      return profile.role == 'technician' && profile.condoId == condoId;
    }

    function isResident(condoId) {
      let profile = getProfile();
      return profile.role == 'resident' && profile.condoId == condoId;
    }

    // Validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['super_admin', 'condo_admin', 'operator', 'technician', 'resident'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role || isSuperAdmin();
    }

    match /condos/{condoId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();

      match /buildings/{buildingId} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin() || isCondoAdmin(condoId);
      }

      match /equipment/{equipmentId} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin() || isCondoAdmin(condoId) || isTechnician(condoId);
      }

      match /incidents/{incidentId} {
        allow read: if isAuthenticated();
        allow create: if isOperator(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOperator(condoId) || isCondoAdmin(condoId) || isTechnician(condoId) || isSuperAdmin();
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /facilities/{facilityId} {
        allow read: if isAuthenticated();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /reservations/{reservationId} {
        allow read: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow create: if isResident(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /visitors/{visitorId} {
        allow read: if isOwner(resource.data.userId) || isOperator(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow create: if isResident(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /plannedVisits/{visitId} {
        allow read: if isAuthenticated();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }
    }
  }
}
