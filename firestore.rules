rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users -> uid
    // Collection: condos -> condoId
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // New more robust getProfile
    function getProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function hasRole(role) {
      let profile = getProfile();
      return profile != null && profile.role == role;
    }

    function isSuperAdmin() {
      // Robust check: either email matches exactly OR user has super_admin role in profile
      return isAuthenticated() && (
        request.auth.token.email == "contacto@porteriavirtual.cl" || 
        hasRole('super_admin')
      );
    }

    function isCondoAdmin(condoId) {
      let profile = getProfile();
      return profile != null && profile.role == 'condo_admin' && profile.condoId == condoId;
    }

    function isOperator(condoId) {
      let profile = getProfile();
      return profile != null && profile.role == 'operator' && profile.condoId == condoId;
    }

    function isTechnician(condoId) {
      let profile = getProfile();
      return profile != null && profile.role == 'technician' && profile.condoId == condoId;
    }

    function isResident(condoId) {
      let profile = getProfile();
      return profile != null && profile.role == 'resident' && profile.condoId == condoId;
    }

    // Validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['super_admin', 'condo_admin', 'operator', 'technician', 'resident'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Root-level access to certain collections for collectionGroup queries
    match /{path=**}/facilities/{facilityId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/equipment/{equipmentId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/incidents/{incidentId} {
      allow read: if isAuthenticated();
    }

    match /users/{userId} {
      // Allow user to read their own profile, or super admin to read all, or condo admin to read their condo's users
      allow read: if isOwner(userId) || isSuperAdmin() || (resource != null && isCondoAdmin(resource.data.condoId));
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || isCondoAdmin(request.resource.data.condoId)) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(userId) || isSuperAdmin() || (resource != null && isCondoAdmin(resource.data.condoId)) || (request.auth.uid == userId && request.resource.data.role == resource.data.role)) && isValidUser(request.resource.data);
      allow delete: if isSuperAdmin() || (resource != null && isCondoAdmin(resource.data.condoId));
    }

    match /condos/{condoId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();

      match /buildings/{buildingId} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin() || isCondoAdmin(condoId);
      }

      match /equipment/{equipmentId} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin() || isCondoAdmin(condoId) || isTechnician(condoId);
      }

      match /incidents/{incidentId} {
        allow read: if isAuthenticated();
        allow create: if isOperator(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOperator(condoId) || isCondoAdmin(condoId) || isTechnician(condoId) || isSuperAdmin();
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /facilities/{facilityId} {
        allow read: if isAuthenticated();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /reservations/{reservationId} {
        allow read: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow create: if isResident(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /visitors/{visitorId} {
        allow read: if isOwner(resource.data.userId) || isOperator(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow create: if isResident(condoId) || isCondoAdmin(condoId) || isSuperAdmin();
        allow update: if isOwner(resource.data.userId) || isCondoAdmin(condoId) || isSuperAdmin();
      }

      match /plannedVisits/{visitId} {
        allow read: if isAuthenticated();
        allow write: if isCondoAdmin(condoId) || isSuperAdmin();
      }
    }
  }
}

