rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "contacto@porteriavirtual.cl" || 
        request.auth.token.email == "cristianmedinaflores@gmail.com" ||
        getProfile().role == 'super_admin'
      );
    }

    function isMasterAdminEmail() {
      return request.auth.token.email in [
        'contacto@porteriavirtual.cl',
        'cristianmedinaflores@gmail.com',
        'contacto@maipobodegas.cl'
      ];
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Direct access for collectionGroup queries
    match /{path=**}/facilities/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/equipment/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/incidents/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/operators/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/access_events/{id} { allow read: if isAuthenticated(); }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /condos/{condoId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();

      // Residents and operators of this condo can read/write visitors
      match /visitors/{visitorId} {
        allow read, write: if isAuthenticated() && (
          isSuperAdmin() ||
          getProfile().condoId == condoId
        );
      }

      match /{allSubcollections=**} {
        allow read: if isAuthenticated() && (isSuperAdmin() || getProfile().condoId == condoId);
        allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin', 'operator']);
      }
    }

    match /notifications/{docId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // Public collection groups
    match /{path=**}/reservations/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/expenses/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/residents/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/visitors/{id} { allow read: if isAuthenticated(); }
  }
}
