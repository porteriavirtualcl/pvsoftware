rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "contacto@porteriavirtual.cl" || 
        request.auth.token.email == "cristianmedinaflores@gmail.com" ||
        getProfile().role == 'super_admin'
      );
    }

    function isMasterAdminEmail() {
      return request.auth.token.email in [
        'contacto@porteriavirtual.cl',
        'cristianmedinaflores@gmail.com',
        'contacto@maipobodegas.cl'
      ];
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Direct access for collectionGroup queries
    match /{path=**}/facilities/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/equipment/{id}  { allow read: if isAuthenticated(); }
    // Incidents: read for all authenticated; write allowed for any staff role
    match /{path=**}/incidents/{id}  {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','operator','technician'];
      allow update: if isAuthenticated() && getProfile().role in ['super_admin','condo_admin','operator','technician'];
    }
    match /{path=**}/operators/{id}     { allow read: if isAuthenticated(); }
    match /{path=**}/access_events/{id} { allow read: if isAuthenticated(); }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Owner or super_admin can always write; condo_admin can manage their staff
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || getProfile().role == 'condo_admin');
      // condo_admin can create staff profiles (technicians, operators) for their condo
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || getProfile().role == 'condo_admin');
      // Allow a user to delete their own pre-registration temp doc (matched by email)
      // This is required for the auth migration flow that moves temp docs to users/{uid}
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || resource.data.email == request.auth.token.email);
    }

    match /condos/{condoId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();

      // Residents and operators of this condo can read/write visitors
      match /visitors/{visitorId} {
        allow read, write: if isAuthenticated() && (
          isSuperAdmin() ||
          getProfile().condoId == condoId
        );
      }

      match /{allSubcollections=**} {
        allow read: if isAuthenticated() && (isSuperAdmin() || getProfile().condoId == condoId);
        allow write: if isAuthenticated() && (isSuperAdmin() || getProfile().role in ['condo_admin', 'operator']);
      }
    }

    match /notifications/{docId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // Public collection groups
    match /{path=**}/reservations/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/expenses/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/residents/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/visitors/{id} { allow read: if isAuthenticated(); }
  }
}
